# air-issuer-service@main_sd-jwt-vc backend (.env) — only these names
NODE_ENV=sandbox

# Optional in sandbox; required for revocation, issuance history and the token status list
DATABASE_URL=
# Stable public HTTPS origin; the issuer DID is did:web:<host>
ISSUER_ORIGIN=http://localhost:3000

PARTNER_ID=
PARTNER_PRIVATE_KEY_KID=
PARTNER_PRIVATE_KEY_ALG=ES256
PARTNER_PRIVATE_KEY_DER=
PARTNER_JWKS=
#SD_JWT_TSL_PARTITION_SIZE=80000

API_KEY=
ADMIN_API_KEY=

# Web app (.env.local) — browser-safe plus the server-only signing and verification names
NEXT_PUBLIC_PARTNER_ID=
NEXT_PUBLIC_ISSUER_DID=
NEXT_PUBLIC_ISSUE_PROGRAM_ID=
NEXT_PUBLIC_VERIFY_PROGRAM_ID=
NEXT_PUBLIC_BUILD_ENV=sandbox
PARTNER_ID=
PARTNER_PRIVATE_KEY_KID=
PARTNER_PRIVATE_KEY_DER=
PARTNER_JWKS=
AIR_VERIFY_PROGRAM_ID=
AIR_TRUSTED_ISSUERS=
AIR_EXPECTED_VCT=
AIR_REQUIRED_CLAIMS=
